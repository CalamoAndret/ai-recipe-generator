# Copie este arquivo para .env.local e preencha o que quiser usar.
# Sem nenhuma chave de IA, o app roda em MODO DEMONSTRAÇÃO com receitas de exemplo.
# Variáveis vazias usam o valor padrão indicado no comentário.

# --- Google Gemini (plano gratuito) -----------------------------------------
# Chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Padrão: gemini-3.8-flash
GEMINI_MODEL=

# --- Anthropic Claude (pago) ----------------------------------------------
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Padrão: claude-opus-5-5
ANTHROPIC_MODEL=
# low | medium | high. Padrão: medium
ANTHROPIC_EFFORT=

# --- Provedor de IA -------------------------------------------------------
# gemini | anthropic. Vazio = usa o primeiro que tiver chave (Gemini primeiro).
AI_PROVIDER=

# --- Fotos dos pratos (opcional) --------------------------------------------
# Chave grátis em https://pixabay.com/api/docs/ . Sem ela, usa TheMealDB (sem chave).
PIXABAY_API_KEY=
